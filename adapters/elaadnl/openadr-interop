#!/usr/local/bin/python3 -I
# SPDX-License-Identifier: MIT
"""Entry point of the openadr-interop adapter for the ElaadNL openadr3-client."""

import os
import sys

sys.path[:0] = ["/opt/openadr-interop", "/opt/openadr-interop/site-packages"]

from openadr_interop.main import main  # noqa: E402  pylint: disable=wrong-import-position

if __name__ == "__main__":
    code = main(sys.argv[1:])
    sys.stdout.flush()
    sys.stderr.flush()
    # Leave without waiting for helper threads.
    os._exit(code)
